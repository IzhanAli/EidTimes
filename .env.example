# Vercel Postgres connection — get these from your Vercel project's Storage tab.
# When you link the project with `vercel link` + `vercel env pull .env.local`,
# these get populated automatically.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
